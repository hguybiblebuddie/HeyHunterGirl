<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Apply to Work With Me — HeyHunterGirl</title>
  <meta name="description" content="Apply to work with Hunter — speaking engagements, podcast collaborations, brand partnerships, and ministry events. Intentional partnerships only.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Lora:ital,wght@0,400;0,600;1,400;1,600&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  {squarespace-headers}
  <style>
    .apply-page-hero {
      background: var(--cream);
      padding: calc(var(--nav-h) + 5rem) 0 5rem;
      text-align: center;
      position: relative;
      overflow: hidden;
    }
    .apply-page-hero::before {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse 65% 75% at 75% 0%, rgba(196,154,60,0.16) 0%, transparent 55%),
                  radial-gradient(ellipse 50% 60% at 0% 90%, rgba(160,88,64,0.07) 0%, transparent 50%);
    }
    .apply-page-hero > * { position: relative; z-index: 1; }
    .apply-page-hero .section-eyebrow { color: var(--terra); }
    .apply-page-hero h1 {
      color: var(--text);
      font-size: clamp(2.5rem, 5vw, 4.5rem);
      margin-bottom: 1.25rem;
    }
    .apply-page-hero p {
      color: var(--text-mid);
      max-width: 560px;
      margin: 0 auto 2rem;
      font-size: 1.05rem;
      line-height: 1.75;
    }
    .apply-page-hero .notice-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: rgba(160,88,64,0.1);
      border: 1px solid rgba(160,88,64,0.25);
      border-radius: 100px;
      padding: 0.45rem 1.1rem;
      color: var(--terra);
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      margin-bottom: 1.5rem;
    }

    /* Partnership types section */
    .partnerships { background: var(--cream-dark); }
    .partnerships-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }
    .partner-type {
      background: var(--white);
      border-radius: 8px;
      padding: 2rem;
      display: flex;
      gap: 1.25rem;
      align-items: flex-start;
      border-top: 3px solid var(--terra);
      transition: transform 0.25s var(--ease-out), box-shadow 0.25s;
    }
    .partner-type:hover {
      transform: translateY(-3px);
      box-shadow: 0 12px 32px rgba(26,56,48,0.08);
    }
    .partner-icon {
      font-size: 1.75rem;
      flex-shrink: 0;
      margin-top: 2px;
    }
    .partner-type h3 { color: var(--forest); font-size: 1.1rem; margin-bottom: 0.4rem; }
    .partner-type p { font-size: 0.88rem; color: var(--text-mid); line-height: 1.65; }

    /* What to expect */
    .apply-process { background: var(--cream); }
    .process-steps {
      display: flex;
      flex-direction: column;
      gap: 0;
      max-width: 700px;
      margin: 0 auto;
      position: relative;
    }
    .process-steps::before {
      content: '';
      position: absolute;
      left: 22px;
      top: 40px;
      bottom: 40px;
      width: 2px;
      background: linear-gradient(to bottom, var(--terra), var(--gold));
    }
    .process-step {
      display: flex;
      gap: 1.5rem;
      align-items: flex-start;
      padding: 1.5rem 0;
      position: relative;
    }
    .step-num {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: var(--white);
      border: 2px solid var(--terra);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 0.9rem;
      color: var(--terra);
      flex-shrink: 0;
      position: relative;
      z-index: 1;
    }
    .step-content h4 { color: var(--forest); font-size: 1rem; margin-bottom: 0.3rem; }
    .step-content p { font-size: 0.88rem; color: var(--text-mid); line-height: 1.65; }

    /* Application form */
    .application-form-section { background: var(--cream-dark); }
    .application-form-section .section-eyebrow { color: var(--terra); }
    .form-layout {
      display: grid;
      grid-template-columns: 1fr 1.6fr;
      gap: 4rem;
      align-items: start;
    }
    .form-sidebar p {
      color: var(--text-mid);
      font-size: 0.92rem;
      line-height: 1.75;
      margin-bottom: 1rem;
    }
    .sidebar-note {
      background: rgba(160,88,64,0.08);
      border-left: 3px solid var(--terra);
      padding: 1rem 1.25rem;
      border-radius: 0 4px 4px 0;
      font-style: italic;
      font-size: 0.88rem;
      color: var(--text-mid);
      line-height: 1.65;
      margin-top: 1.5rem;
    }
    .application-form-section .form-card {
      border-top-color: var(--terra);
    }

    @media (max-width: 900px) {
      .form-layout { grid-template-columns: 1fr; gap: 2.5rem; }
    }
    @media (max-width: 700px) {
      .partnerships-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>

  <header class="site-header" id="site-header">
    <nav class="nav-container">
      <a href="/" class="nav-logo">
        <span class="logo-hey">Hey</span><span class="logo-hunter">Hunter</span><span class="logo-girl">Girl</span>
      </a>
      <button class="nav-toggle" id="nav-toggle" aria-label="Toggle navigation" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
      <div class="nav-links" id="nav-links">
        <a href="/#about">About</a>
        <a href="/speaking">Speaking</a>
        <a href="/podcast">Podcast</a>
        <a href="/#accomplishments">Work</a>
        <a href="/#testimonials">Reviews</a>
        <a href="/apply" class="nav-cta btn btn-outline">Work With Me</a>
      </div>
    </nav>
  </header>

  <!-- HERO -->
  <section class="apply-page-hero">
    <div class="container">
      <p class="section-eyebrow">Intentional Partnership</p>
      <div class="notice-pill">
        <span>●</span> Applications Reviewed Personally
      </div>
      <h1>Apply to Work<br>With Me</h1>
      <p>I don't take every opportunity — I take the right ones. If you believe we're aligned in purpose, mission, and impact, I want to hear from you. Tell me what you're building.</p>
    </div>
  </section>

  <!-- PARTNERSHIP TYPES -->
  <section class="partnerships section">
    <div class="container">
      <div class="section-header">
        <p class="section-eyebrow">What I Do</p>
        <h2 class="section-title">Ways We Can Work Together</h2>
        <p class="section-subtitle">Each partnership is built with intention. Here's what I'm currently open to.</p>
      </div>
      <div class="partnerships-grid">
        <div class="partner-type">
          <div class="partner-icon">🎤</div>
          <div>
            <h3>Speaking Engagements</h3>
            <p>Keynotes, panels, breakouts, fireside chats. For conferences, churches, campuses, corporate events, and leadership summits. I come prepared and I deliver.</p>
          </div>
        </div>
        <div class="partner-type">
          <div class="partner-icon">🎙️</div>
          <div>
            <h3>Podcast Collaborations</h3>
            <p>Guest appearances on shows aligned with identity, faith, personal development, entrepreneurship, or leadership. I show up ready to give your audience real value.</p>
          </div>
        </div>
        <div class="partner-type">
          <div class="partner-icon">🤝</div>
          <div>
            <h3>Brand Partnerships</h3>
            <p>Selective brand deals with companies and products I actually use and believe in. I only partner where the alignment is genuine — my audience can always tell.</p>
          </div>
        </div>
        <div class="partner-type">
          <div class="partner-icon">⛪</div>
          <div>
            <h3>Ministry &amp; Church Events</h3>
            <p>Women's ministry, young adult gatherings, church conferences, and faith-based leadership development. This work is close to my heart.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- THE PROCESS -->
  <section class="apply-process section">
    <div class="container">
      <div class="section-header">
        <p class="section-eyebrow">What Happens Next</p>
        <h2 class="section-title">The Process</h2>
        <p class="section-subtitle">Here's what to expect after you submit your application.</p>
      </div>
      <div class="process-steps">
        <div class="process-step">
          <div class="step-num">01</div>
          <div class="step-content">
            <h4>Submit Your Application</h4>
            <p>Fill out the form below with as much detail as possible. The more you share about what you're building, the better I can assess the fit.</p>
          </div>
        </div>
        <div class="process-step">
          <div class="step-num">02</div>
          <div class="step-content">
            <h4>Personal Review (3–5 Business Days)</h4>
            <p>I read every application personally. No bots, no assistants. You'll hear back from me directly.</p>
          </div>
        </div>
        <div class="process-step">
          <div class="step-num">03</div>
          <div class="step-content">
            <h4>Intro Call</h4>
            <p>If it looks like a strong fit, I'll reach out to schedule a brief call so we can connect and confirm alignment before moving forward.</p>
          </div>
        </div>
        <div class="process-step">
          <div class="step-num">04</div>
          <div class="step-content">
            <h4>Let's Build</h4>
            <p>We finalize the details, get agreements in place, and get to work. I bring my best — you'll see that from day one.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- APPLICATION FORM -->
  <section class="application-form-section section" id="application">
    <div class="container">
      <div class="section-header">
        <p class="section-eyebrow">Apply Now</p>
        <h2 class="section-title">Tell Me What You're Building</h2>
      </div>
      <div class="form-layout">
        <div class="form-sidebar">
          <p>I'm not just looking for the right opportunity — I'm looking for the right partnership. The best applications are specific, honest, and clear about what you actually need.</p>
          <p>Not sure if it's a fit? Apply anyway. The worst I can say is not right now.</p>
          <div class="sidebar-note">
            "If you're reading this and wondering if I'd be right for your event — ask yourself: do I want people in my room who leave with a new understanding of themselves? If yes, let's talk."
          </div>
        </div>
        <div>
          <div class="form-card">
            <h3>Partnership Application</h3>
            <!-- ↓ Replace with Squarespace Form Block ↓ -->
            <p style="font-size:0.85rem;color:var(--text-light);background:var(--cream);padding:1.25rem;border-radius:4px;line-height:1.8;border:1px solid var(--cream-dark);">
              <strong>Editor Note:</strong> Replace this with a Squarespace Form Block with the following fields:<br><br>
              • First &amp; Last Name <em>(required)</em><br>
              • Email Address <em>(required)</em><br>
              • Phone Number <em>(optional)</em><br>
              • Organization / Company / Church Name <em>(required)</em><br>
              • Partnership Type — <em>dropdown: Speaking / Podcast Guest / Brand Partnership / Ministry Event / Other</em><br>
              • How did you hear about Hunter?<br>
              • Event or opportunity name (if applicable)<br>
              • Proposed date or timeframe<br>
              • Estimated audience size or reach<br>
              • Budget range (if speaking) — <em>dropdown options</em><br>
              • Describe what you're building and how you see Hunter contributing to it <em>(required, long text)</em><br>
              • Why do you believe this is a good fit?<br>
              • Anything else you want me to know<br><br>
              Set form notification email to your address. Enable Google reCAPTCHA. Thank-you message: "Thank you for applying. I review every application personally and will be in touch within 3–5 business days."
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="site-footer">
    <div class="container">
      <div class="footer-grid">
        <div class="footer-brand">
          <a href="/" class="footer-logo">HeyHunterGirl</a>
          <p>Speaker. Podcast Host. Builder.</p>
          <p class="footer-tagline">Glorifying God by becoming<br>who He made me to be.</p>
        </div>
        <div class="footer-nav">
          <h4>Navigate</h4>
          <ul>
            <li><a href="/">Home</a></li>
            <li><a href="/about">About</a></li>
            <li><a href="/speaking">Speaking</a></li>
            <li><a href="/podcast">Podcast</a></li>
            <li><a href="/apply">Work With Me</a></li>
          </ul>
        </div>
        <div class="footer-social">
          <h4>Connect</h4>
          <div class="footer-social-links">
            <a href="https://instagram.com/heyhuntergirl" target="_blank" rel="noopener noreferrer">Instagram</a>
            <a href="https://linkedin.com/in/heyhuntergirl" target="_blank" rel="noopener noreferrer">LinkedIn</a>
            <a href="https://youtube.com/@heyhuntergirl" target="_blank" rel="noopener noreferrer">YouTube</a>
            <a href="https://tiktok.com/@heyhuntergirl" target="_blank" rel="noopener noreferrer">TikTok</a>
            <a href="/podcast">Podcast</a>
          </div>
        </div>
        <div class="footer-cta">
          <h4>Prefer Speaking?</h4>
          <p>Go directly to the speaking inquiry form.</p>
          <a href="/speaking#inquiry" class="btn btn-primary btn-sm">Speaking Inquiry</a>
        </div>
      </div>
      <div class="footer-bottom">
        <p>© 2025 HeyHunterGirl. All rights reserved.</p>
        <p>heyhuntergirl.com</p>
      </div>
    </div>
  </footer>

  {squarespace-footers}
</body>
</html>
